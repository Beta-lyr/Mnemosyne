# ===== LLM 配置 =====
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Embedding 模型
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 如果使用 OpenAI Embedding，取消下面的注释
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ===== 数据库 =====
DATABASE_URL=postgresql://mnemosyne:password@localhost:5432/mnemosyne
REDIS_URL=redis://localhost:6379/0

# ===== 图像生成 =====
# Provider: replicate | fal | stability | huggingface | openai-compatible
IMAGE_PROVIDER=replicate
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
# Legacy (fallback if IMAGE_API_KEY empty)
REPLICATE_API_TOKEN=r8_xxx
# FAL_KEY=xxx

# ===== 音频生成（可选）=====
# Provider: elevenlabs | huggingface | openai-compatible
# AUDIO_PROVIDER=elevenlabs
# AUDIO_API_KEY=
# AUDIO_BASE_URL=
# AUDIO_MODEL=

# ===== 视频生成（可选）=====
# Provider: replicate | huggingface | luma
# VIDEO_PROVIDER=replicate
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# ===== Telegram（可选）=====
# TELEGRAM_BOT_TOKEN_1=123456:ABC-DEF
# TELEGRAM_BOT_TOKEN_2=789012:GHI-JKL

# ===== S3 存储（可选，不配置则使用本地存储）=====
# S3_BUCKET=mnemosyne
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PREFIX=mnemosyne/uploads

# ===== Web =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
SECRET_KEY=change-me-to-a-random-string

# ===== 主动触发 =====
MAX_DAILY_MESSAGES=2
COOLDOWN_MINUTES=10
QUIET_HOURS_START=0
QUIET_HOURS_END=7
